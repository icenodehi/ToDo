; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Eisbrise"
config/version="1.0.0"
run/main_scene="uid://cph8x33gmv8fk"
config/use_custom_user_dir=true
config/custom_user_dir_name="Eisbrise"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://diccukn56d167"

[autoload]

AppSettings="*uid://dd520ykvpadml"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://ToDo/": "red",
"res://ToDo/autoLoad/": "purple",
"res://ToDo/localization/": "pink",
"res://ToDo/resource/": "green",
"res://ToDo/scenes/": "blue",
"res://ToDo/scripts/": "yellow"
}

[input]

save={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":71,"key_label":0,"unicode":103,"location":0,"echo":false,"script":null)
]
}

[internationalization]

locale/translations=PackedStringArray("res://ToDo/localization/translations.en.translation", "res://ToDo/localization/translations.ru.translation")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
